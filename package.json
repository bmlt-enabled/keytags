{
    "name": "virtual-keytags",
    "version": "0.1.0",
    "description": "Send a virtual NA clean-time keytag — a zero-storage, URL-encoded keepsake card.",
    "type": "module",
    "license": "MIT",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "format": "prettier --write .",
        "lint": "prettier --check . && eslint . && svelte-check",
        "all": "npm run format && npm run lint && npm run test && npm run build"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.1",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/svelte": "^5.4.2",
        "@tsconfig/svelte": "^5.0.8",
        "@types/node": "^26.6.5",
        "@vitest/coverage-v8": "^5.0.5",
        "axe-playwright": "^2.2.2",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.23.1",
        "globals": "^17.13.0",
        "jsdom": "^30.1.3",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte": "^5.57.3",
        "svelte-check": "^4.7.7",
        "svelte-eslint-parser": "^1.10.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "dependencies": {
        "html-to-image": "^1.11.13"
    }
}
